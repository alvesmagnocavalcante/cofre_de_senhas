# Banco PostgreSQL da Aiven.
DATABASE_URL=postgres://usuario:SENHA_CODIFICADA@host:porta/defaultdb?sslmode=require
DATABASE_CONN_MAX_AGE=60

# Opcional: habilita sslmode=verify-full com a CA da Aiven.
# DATABASE_CA_CERT=/run/secrets/aiven-ca.pem

# Configuração obrigatória em produção.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=SUBSTITUA_POR_UM_VALOR_LONGO_E_ALEATORIO
VAULT_ENCRYPTION_KEYS=SUBSTITUA_POR_UMA_CHAVE_FERNET
DJANGO_ALLOWED_HOSTS=cofre.exemplo.com

# Use somente atrás de um proxy reverso confiável.
DJANGO_TRUST_PROXY_SSL_HEADER=true
